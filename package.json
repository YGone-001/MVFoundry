{
  "name": "mvfoundry",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, agent-driven AI music video production framework powered by Remotion.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mv:workflow": "npm run build && node factory/scripts/mv-workflow.mjs",
    "workflow:verify": "npm run build && node factory/scripts/verify-mv-workflow.mjs",
    "typecheck": "tsc -p factory/tsconfig.json --noEmit",
    "build": "tsc -p factory/tsconfig.json",
    "fixtures": "node factory/scripts/generate-fixtures.mjs",
    "test": "npm run fixtures && npm run build && node factory/scripts/run-tests.mjs",
    "compositions": "remotion compositions factory/src/entry.tsx",
    "seed:examples": "npm run build && npm run fixtures && node factory/scripts/seed-workspace.mjs",
    "media:seed": "npm run build && node factory/scripts/seed-media-workspace.mjs",
    "media:verify": "npm run build && node factory/scripts/verify-media-render.mjs",
    "audio:seed": "npm run build && node factory/scripts/seed-audio-workspace.mjs",
    "audio:verify": "npm run build && node factory/scripts/verify-audio-render.mjs",
    "preproduction": "npm run build && node factory/scripts/preproduction.mjs",
    "preproduction:seed": "npm run build && node factory/scripts/seed-preproduction-workspace.mjs",
    "preproduction:verify": "npm run build && node factory/scripts/verify-preproduction.mjs",
    "handoff:seed": "npm run build && node factory/scripts/seed-media-handoff-workspace.mjs",
    "handoff:verify": "npm run build && node factory/scripts/verify-media-handoff.mjs",
    "generation": "npm run build && node factory/scripts/generation.mjs",
    "generation:seed": "npm run build && node factory/scripts/seed-generation-workspace.mjs",
    "generation:verify": "npm run build && node factory/scripts/verify-generation.mjs",
    "provider:seed": "npm run build && node factory/scripts/seed-provider-workspace.mjs",
    "provider:verify": "npm run build && node factory/scripts/verify-provider-output.mjs",
    "golive:seed": "npm run build && node factory/scripts/seed-golive-workspace.mjs",
    "golive:verify": "npm run build && node factory/scripts/verify-golive-readiness.mjs",
    "pilot:seed": "npm run build && node factory/scripts/seed-pilot-workspace.mjs",
    "pilot:verify": "npm run build && node factory/scripts/verify-pilot-admission.mjs",
    "mv:seed": "npm run build && node factory/scripts/seed-mv-production.mjs",
    "mv:produce": "npm run build && node factory/scripts/produce-mv.mjs",
    "mv:verify": "npm run build && node factory/scripts/verify-mv-production.mjs",
    "mv:seed-b": "npm run build && node factory/scripts/seed-mv-project-b.mjs",
    "mv:verify-b": "npm run build && node factory/scripts/verify-mv-project-b.mjs",
    "render:project": "npm run build && node factory/scripts/render-project.mjs",
    "verify:modules": "npm run build && node factory/scripts/verify-module-render.mjs",
    "audit:git": "npm run build && node factory/scripts/audit-git.mjs",
    "audit:publication": "node security/audit-publication.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
